-#}

{%
	import { getuid, getspnam } from 'luci.core';

	const boardinfo = ubus.call('system', 'board') ?? {};
	const cn = config.corenet ?? {};
	const def_lang = match(cn.lang ?? '', /^(fa|en)$/) ? cn.lang : (match(dispatcher.lang ?? '', /^fa/) ? 'fa' : 'auto');
	const def_theme = match(cn.theme ?? '', /^(dark|light|auto)$/) ? cn.theme : 'dark';
	const ver = '1.0.0';

	http.prepare_content('text/html; charset=UTF-8');
-%}

<!DOCTYPE html>
<html lang="{{ dispatcher.lang }}" data-darkmode="true" data-cn-lang="en">
	<head>
		<meta charset="utf-8">
		<title>{{ striptags(`${boardinfo.hostname ?? '?'}${dispatched?.title ? ` | ${_(dispatched.title)}` : ''}`) }}</title>
		<script>
			(function () {
				var d = document.documentElement, t = null, l = null;
				try { t = localStorage.getItem('cn-theme'); l = localStorage.getItem('cn-lang'); } catch (e) {}
				t = t || '{{ def_theme }}';
				l = l || '{{ def_lang }}';
				if (l === 'auto') l = /^fa/i.test(navigator.language || '') ? 'fa' : 'en';
				var mq = window.matchMedia('(prefers-color-scheme: dark)');
				var apply = function () {
					var cur = d.getAttribute('data-cn-theme');
					d.setAttribute('data-darkmode', cur === 'auto' ? String(mq.matches) : String(cur !== 'light'));
				};
				d.setAttribute('data-cn-theme', t);
				d.setAttribute('data-cn-lang', l);
				apply();
				mq.addEventListener('change', apply);
				window.cnApplyTheme = apply;
			})();
		</script>
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<meta name="darkreader-lock">
		<meta name="theme-color" content="#05070d">
		<link rel="stylesheet" href="{{ media }}/base.css?v={{ ver }}">
		<link rel="stylesheet" media="only screen and (max-device-width: 854px)" href="{{ media }}/base-mobile.css?v={{ ver }}">
		<link rel="stylesheet" href="{{ media }}/corenet.css?v={{ ver }}">
		<link rel="icon" href="{{ media }}/logo.svg" sizes="any" type="image/svg+xml">
		<link rel="apple-touch-icon" href="{{ media }}/logo.svg">
		{% if (node?.css): %}
		<link rel="stylesheet" href="{{ resource }}/{{ node.css }}">
		{% endif %}
		{% if (css): %}
		<style title="text/css">{{ css }}</style>
		{% endif %}
		<script src="{{ dispatcher.build_url('admin/translations', dispatcher.lang) }}"></script>
		<script src="{{ resource }}/cbi.js"></script>
	</head>

	<body class="cn lang_{{ dispatcher.lang }} {{ entityencode(striptags(node?.title ?? ''), true) }}" data-page="{{ entityencode(join('-', ctx.request_path), true) }}">
		{% if (!blank_page): %}
		<div id="cn-shell">
			<aside id="cn-side">
				<a class="cn-brand" href="{{ dispatcher.build_url() }}">
					<img src="{{ media }}/logo.svg" alt="" width="38" height="38">
					<span class="cn-brand-txt">
						<b>{{ striptags(boardinfo.hostname ?? 'OpenWrt') }}</b>
						<small>{{ striptags(boardinfo.model ?? '') }}</small>
					</span>
				</a>
				<button type="button" id="cn-search-btn" class="cn-search-btn">
					<svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
					<span class="cn-i18n" data-en="Search menus…" data-fa="جستجو در منوها…">Search menus…</span>
					<kbd>Ctrl K</kbd>
				</button>
				<nav id="cn-nav" aria-label="Main menu"></nav>
				<div class="cn-side-foot">
					<button type="button" class="cn-chip" id="cn-lang-btn" title="Language / زبان">
						<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/></svg>
						<span id="cn-lang-lbl">EN</span>
					</button>
					<button type="button" class="cn-chip" id="cn-theme-btn" title="Theme">
						<svg viewBox="0 0 24 24"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
						<span id="cn-theme-lbl">Dark</span>
					</button>
					<a class="cn-chip cn-logout" href="{{ dispatcher.build_url('admin/logout') }}" title="Log out">
						<svg viewBox="0 0 24 24"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4M10 17l5-5-5-5M15 12H3"/></svg>
						<span class="cn-i18n" data-en="Log out" data-fa="خروج">Log out</span>
					</a>
				</div>
			</aside>
			<div id="cn-scrim"></div>
			<div id="cn-main">
				<header id="cn-top">
					<button type="button" id="cn-burger" aria-label="Menu">
						<svg viewBox="0 0 24 24"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
					</button>
					<div id="cn-crumbs"></div>
					<div id="indicators"></div>
					<div class="cn-top-actions">
						<button type="button" id="cn-help-btn" class="cn-icon-btn" title="Help">
							<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M9.5 9a2.5 2.5 0 1 1 3.5 2.3c-.7.3-1 .9-1 1.7M12 17h.01"/></svg>
						</button>
						<button type="button" id="cn-search-btn2" class="cn-icon-btn" title="Search">
							<svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
						</button>
					</div>
				</header>

				<div id="maincontent">
					{% if (getuid() == 0 && getspnam('root')?.pwdp === ''): %}
						<div class="alert-message warning">
							<h4>{{ _('No password set!') }}</h4>
							<p>{{ _('There is no password set on this router. Please configure a root password to protect the web interface.') }}</p>
							{% if (dispatcher.lookup("admin/system/admin")): %}
							  <div class="right"><a class="btn" href="{{ dispatcher.build_url("admin/system/admin") }}">{{ _('Go to password configuration...') }}</a></div>
							{% endif %}
						</div>
					{% endif %}

					{% if (boardinfo.rootfs_type == "initramfs"): %}
						<div class="alert-message warning">
							<h4>{{ _('System running in recovery (initramfs) mode.') }}</h4>
							<p>{{ _('No changes to settings will be stored and are lost after rebooting. This mode should only be used to install a firmware upgrade') }}</p>
							{% if (dispatcher.lookup("admin/system/flash")): %}
							  <div class="right"><a class="btn" href="{{ dispatcher.build_url("admin/system/flash") }}">{{ _('Go to firmware upgrade...') }}</a></div>
							{% endif %}
						</div>
					{% endif %}

					<noscript>
						<div class="alert-message warning">
							<h4>{{ _('JavaScript required!') }}</h4>
							<p>{{ _('You must enable JavaScript in your browser or LuCI will not work properly.') }}</p>
						</div>
					</noscript>

					<div id="cn-help"></div>
					<div id="cn-dash"></div>
					<div id="tabmenu" style="display:none"></div>
		{% endif %}

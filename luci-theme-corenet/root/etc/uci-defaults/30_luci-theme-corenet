#!/bin/sh

# Register the CoreNet theme and its settings section (lang: auto|fa|en, theme: dark|light|auto).
uci -q get luci.corenet >/dev/null || {
	uci set luci.corenet=corenet
	uci set luci.corenet.lang='auto'
	uci set luci.corenet.theme='dark'
}
uci set luci.themes.CoreNet='/luci-static/corenet'
uci commit luci

[ -x /etc/init.d/rpcd ] && /etc/init.d/rpcd reload >/dev/null 2>&1

exit 0
